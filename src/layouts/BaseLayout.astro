---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import { navLinks } from '../data/nav';
import { withBase } from '../utils/urls';

interface Props {
  title: string;
  description?: string;
  /** Extra classes merged onto `<main>` (layout spacing is always applied). */
  mainClass?: string;
}

const { title, description, mainClass = '' } = Astro.props;
const siteTitle = 'Triston Grayston';
const pageTitle = title === siteTitle ? title : `${title} · ${siteTitle}`;

const stripSlash = (path: string) => path.replace(/\/+$/, '');
const currentPath = stripSlash(Astro.url.pathname);
const isCurrent = (href: string) => {
  if (href.startsWith('mailto:')) return false;
  const target = stripSlash(href);
  return currentPath === target || currentPath.startsWith(`${target}/`);
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    {description ? <meta name="description" content={description} /> : null}
    <ViewTransitions />
  </head>
  <body
    class="min-h-dvh font-sans text-[15px] sm:text-base leading-relaxed text-muted"
  >
    <header class="mx-auto flex max-w-[650px] flex-wrap items-baseline justify-between gap-x-6 gap-y-2 px-5 py-8 sm:py-10">
      <a
        href={withBase('')}
        class="text-sm font-medium tracking-tight text-heading transition-colors duration-200 hover:text-highlight"
      >
        {siteTitle}
      </a>
      <nav aria-label="Primary" class="flex flex-wrap gap-x-6 gap-y-1 text-sm">
        {
          navLinks.map((link) => {
            const current = isCurrent(link.href);
            return (
              <a
                href={link.href}
                aria-current={current ? 'page' : undefined}
                class:list={[
                  'transition-colors duration-200 hover:text-highlight',
                  current ? 'text-highlight' : 'text-muted/90',
                ]}
              >
                {link.label}
              </a>
            );
          })
        }
      </nav>
    </header>
    <main class:list={['mx-auto max-w-[650px] px-5 pt-2 pb-20 sm:pb-28', mainClass]}>
      <slot />
    </main>
  </body>
</html>
