---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import portrait from '../assets/catba.jpeg';
---

<BaseLayout
  title="Triston Grayston"
  description="Masters in Computer Science at the University of Alberta"
>
  <div class="space-y-10 sm:space-y-14">
    <div class="space-y-6 pt-6 sm:pt-10">
      <h1 class="text-4xl font-semibold tracking-tight text-heading sm:text-5xl">Hey, my name is Triston!</h1>
      <div class="h-56 w-56 overflow-hidden rounded-full sm:h-72 sm:w-72">
        <Image
          src={portrait}
          alt="Triston Grayston on Cat Ba Island"
          width={1600}
          loading="eager"
          class="h-full w-full object-cover"
          style="transform: scale(1.7); transform-origin: 47% 54%;"
        />
      </div>
      <div class="max-w-prose space-y-4 leading-7 text-muted">
        <p>
          I am a Masters student in Computer Science at the University of Alberta, studying how information is learned
          and represented within various types of systems that we think learn information. I'm doing so under the
          supervision of Dr. Erin Grant and Dr. Alona Fyshe!
        </p>
        <p>
          I prioritize growth in most forms, and yap more than I ought to on topics I'm not nearly familiar enough with.
        </p>
        <p>
          On this page, you'll see things that I've done, some thoughts about random topics, and ways to reach out should
          you feel the need.
        </p>
      </div>
    </div>

    <footer class="border-t border-black/10 pt-10">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted">
        <li>
          <a
            href="https://github.com/tristongrayston"
            class="transition-colors duration-200 hover:text-highlight"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </a>
        </li>
        <li>
          <a
            href="https://www.linkedin.com/in/triston-grayston-9a3111224"
            class="transition-colors duration-200 hover:text-highlight"
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn
          </a>
        </li>
        <li>
          <a href="mailto:graystontriston@gmail.com" class="transition-colors duration-200 hover:text-highlight">
            Email
          </a>
        </li>
      </ul>
    </footer>
  </div>
</BaseLayout>
